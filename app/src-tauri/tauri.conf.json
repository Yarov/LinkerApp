{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Linker",
  "version": "0.1.0",
  "identifier": "com.linker.wisp",
  "build": {
    "frontendDist": "http://localhost:4983",
    "devUrl": "http://localhost:4983",
    "beforeDevCommand": "npm run dev -- --port 4983",
    "beforeBuildCommand": "node scripts/build-prod.js"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Linker - WISP Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../dist/server.tar.gz"
    ]
  }
}
